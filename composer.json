{
    "name": "componist/developer-bar",
    "description": "Example Laravel developer bar with Tailwind CSS v4, Alpine.js, and Livewire middleware injection for local debugging",
    "keywords": [
        "laravel",
        "developer-bar",
        "livewire",
        "tailwind",
        "alpinejs",
        "debug",
        "vite",
        "componist"
    ],
    "homepage": "https://componist.dev",
    "license": "MIT",
    "authors": [
        {
            "name": "Componist Developer",
            "email": "info@componist.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "larastan/larastan": "^3.9"
    },
    "scripts": {
        "phpstan": "phpstan analyse -c phpstan.neon.dist"
    },
    "autoload": {
        "psr-4": {
            "Componist\\DeveloperBar\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0.x-dev"
        },
        "laravel": {
            "providers": [
                "Componist\\DeveloperBar\\DeveloperBarServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}